# SC_SecConfig.yaml  -- HermesLocalMode example
# Copy this file to data/yaml/SC_SecConfig.yaml and fill in your settings.

# ─── LLM (Hermes) ────────────────────────────────────────────────────────
# Point endpoint at the companion server. The companion server can proxy to
# LM Studio / Ollama / llama.cpp via --llm-endpoint.
hermes:
  endpoint: "http://192.168.1.100:8080/v1/chat/completions"
  model: "gemma-3-4b-it"
  api_key: "lm-studio"
  max_tokens: 80
  timeout_ms: 30000

# ─── Local Mobile LLM / Companion Server ─────────────────────────────────
# Run: python local-llm-server/server.py --port 8080 --whisper-model small
local_host: "192.168.1.100:8080"

# stt_mode: "google" (Google Cloud) or "whisper" (local companion server)
stt_mode: "whisper"

# tts_mode: "" (VOICEVOX cloud) | "voicevox_local" | "openai" (companion server)
tts_mode: "openai"

# Voice for companion server edge-tts.
# Examples: ja-JP-NanamiNeural, ja-JP-KeitaNeural
tts_voice: "ja-JP-NanamiNeural"

# VAD settings
vad_threshold: 300
vad_tail_ms: 500

# ─── Google STT (only needed when stt_mode: google) ──────────────────────
stt_api_key: ""

# ─── VOICEVOX TTS ────────────────────────────────────────────────────────
tts_api_key: ""
voicevox_host: ""
voicevox_speaker: 1
tts_volume: 100

# ─── WiFi ────────────────────────────────────────────────────────────────
wifi_list:
  - ssid: "YOUR_SSID_1"
    password:"YOUR_PASS_1"
  - ssid: "YOUR_SSID_2"
    password:"YOUR_PASS_2"

# ─── その他HermesLLMの設定 ───────────────────────────────────────────────
brightness: 80
servo_on_boot: true
play_bpm: 0
